{
  "name": "analisai-api",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node scripts/migrate.js",
    "db:inspect": "node scripts/inspect-database.js",
    "admin:create": "node scripts/create-admin.js",
    "check:integrity": "node scripts/check-integrity.js",
    "check:syntax": "find src scripts tests -type f -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "entities": "^8.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sanitize-html": "^2.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "argon2@0.44.0": true
  }
}
